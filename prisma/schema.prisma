datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model Project {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(200)
  slug        String         @unique @db.VarChar(220)
  category    String         @db.VarChar(100)
  location    String?        @db.VarChar(150)
  client      String?        @db.VarChar(150)
  capacity    String?        @db.VarChar(50)
  year        Int?
  status      ProjectStatus  @default(Selesai)
  isFeatured  Boolean        @default(false) @map("is_featured")
  coverImage  String?        @map("cover_image") @db.VarChar(255)
  description String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
  images      ProjectImage[]

  @@map("projects")
}

enum ProjectStatus {
  Perencanaan
  Berjalan
  Selesai
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int     @map("project_id")
  imageUrl  String  @map("image_url") @db.VarChar(255)
  caption   String? @db.VarChar(200)
  sortOrder Int?    @default(0) @map("sort_order")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_images_project_id_fkey")
  @@map("project_images")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  subject   String?  @db.VarChar(200)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
